# shellcheck source=/dev/null

# Source the system bashrc first.
if [ -f /etc/bashrc ]; then source /etc/bashrc; fi

# Source user config from ~/.config/bash/config.bash
if [ -f "$HOME/.config/bash/config.bash" ]; then
  # shellcheck source=.config/bash/config.bash
  source "$HOME/.config/bash/config.bash"
fi
